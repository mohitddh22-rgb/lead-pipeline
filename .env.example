# Google Sheets
GOOGLE_SHEETS_CREDENTIALS='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"sheets@project.iam.gserviceaccount.com"}'
SPREADSHEET_ID=your_spreadsheet_id
SHEET_NAME=Leads

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Sender identity for outbound cold email. Defaults to sales@spaciab2b.com if unset.
FROM_EMAIL=sales@spaciab2b.com
# Subject line template. Placeholders: {{company}} {{location}} {{email}} {{region}} {{website}} {{first_name}}
EMAIL_SUBJECT=Real estate tech for {{company}}
# Body template — PLAIN TEXT (no HTML). Literal \n becomes a real line break.
# Same placeholders as subject. When unset, an auto-generated HTML lead message is used.
EMAIL_BODY_TEMPLATE=Hi {{first_name}},\n\nI'm Mohit, Co-Founder & CTO at Strandix System India. We build white-label real estate platforms for property companies.\n\nIf this sounds relevant, check out https://www.spaciab2b.com\n\nBest,\nMohit Dadhich
UNSUBSCRIBE_URL=https://yourdomain.com/unsubscribe

# Scraping (Browserless)
BROWSERLESS_API_KEY=your_browserless_token
SOURCES_US=https://example.com/us-listings
SOURCES_EU=https://example.com/eu-listings
SOURCES_AU=https://example.com/au-listings

# Apollo.io (primary prospect API) — free search, credit-gated enrich
# Free tier: 75 credits/mo; Basic: 2,500/mo; Pro: 4,000/mo
APOLLO_API_KEY=your_apollo_api_key

# Outscraper (Google Maps business discovery) — pay-as-you-go
# Free tier: 500 places/mo + 500 email enrichments/mo
# Then $3/1,000 records
OUTSCRAPER_API_KEY=your_outscraper_api_key

# Hunter.io (email finder & verifier)
# Free tier: 50 credits/mo (25 searches + 25 verifications)
# Starter: $34/mo (2,000 credits/mo)
HUNTER_API_KEY=your_hunter_api_key

# Queue (Upstash QStash) — optional; enables async queue mode when set
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Suppression store (Upstash Redis) — opt-out tracking
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Security
CRON_SECRET=replace_with_a_long_random_string

# Runtime
BATCH_SIZE=50
PUBLIC_BASE_URL=https://your-app.vercel.app
