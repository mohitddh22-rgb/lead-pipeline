{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "crons": [
    { "path": "/api/cron/batch-process", "schedule": "0 9 * * *" }
  ],
  "functions": {
    "app/api/cron/batch-process/route.js": { "maxDuration": 60 },
    "app/api/worker/route.js":              { "maxDuration": 60 },
    "app/api/email/send/route.js":         { "maxDuration": 30 }
  }
}
